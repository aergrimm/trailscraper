{
  "scrapers": [
    {
      "name": "GoTrailNL",
      "enabled": false,
      "url": "https://gotrail.run/trail-running-kalender/nederland",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
      },
      "selectors": {
        "event_card": ".event-card-main",
        "title": ".event-card-title",
        "date_month": ".event-calendar div:nth-child(1)",
        "date_day": ".event-calendar div:nth-child(2)",
        "distances": ".event-card-distances, .label-distance",
		"location": ".event-card-location",
        "link": ".event-card-title-link",
		"next_page": "a[aria-label='Volgende']"
      }
    },
	  {
      "name": "TrailKalenderNL",
      "enabled": false,
      "url": "https://trailkalender.nl/kalender/",
      "headers": {
		"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36",
		"Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8",
		"Accept-Language": "nl-NL,nl;q=0.9,en-US;q=0.8,en;q=0.7",
		"Cache-Control": "max-age=0",
		"Sec-Ch-Ua": "\"Chromium\";v=\"128\", \"Not=A?Brand\";v=\"24\", \"Google Chrome\";v=\"128\"",
		"Sec-Ch-Ua-Mobile": "?0",
		"Sec-Ch-Ua-Platform": "\"Windows\"",
		"Sec-Fetch-Dest": "document",
		"Sec-Fetch-Mode": "navigate",
		"Sec-Fetch-Site": "none",
		"Sec-Fetch-User": "?1",
		"Upgrade-Insecure-Requests": "1"
      },
      "selectors": {
        "event_card": ".tk-card",
        "title": ".tk-title",
        "date": ".tk-meta > div:first-child",
        "location": ".tk-meta > div:nth-child(2)",
		"distances": ".tk-meta > div:nth-child(3)",
        "link": "",
		"next_page": ""
      }
    },
	  {
      "name": "BeTrailNL",
      "enabled": true,
      "url": "https://www.betrail.run/nl/calendar/nederland",
      "headers": {
		"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36",
		"Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8",
		"Accept-Language": "nl-NL,nl;q=0.9,en-US;q=0.8,en;q=0.7",
		"Cache-Control": "max-age=0",
		"Sec-Ch-Ua": "\"Chromium\";v=\"128\", \"Not=A?Brand\";v=\"24\", \"Google Chrome\";v=\"128\"",
		"Sec-Ch-Ua-Mobile": "?0",
		"Sec-Ch-Ua-Platform": "\"Windows\"",
		"Sec-Fetch-Dest": "document",
		"Sec-Fetch-Mode": "navigate",
		"Sec-Fetch-Site": "none",
		"Sec-Fetch-User": "?1",
		"Upgrade-Insecure-Requests": "1"
      },
      "selectors": {
        "event_card": ".calendar-event",
        "title": ".eventName",
        "date_month": ".eventDates .month",
        "date_day": ".eventDates .day",
        "location": ".place-name",
		"distances": ".event-races .distance",
        "link": "",
		"next_page": ""
      }
    }
  ]
}